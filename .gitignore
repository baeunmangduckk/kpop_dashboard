# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP 테스트 산출물
.playwright-mcp/

# 유튜브 댓글 원본은 로컬에만 보관 (타인 작성 글이라 저장소에 올리지 않음)
data/raw/youtube/*/comments/

# 파이썬 분석 환경과 로컬 전용 분석 산출물
.venv/
__pycache__/
data/raw/youtube/*/sentiment/
